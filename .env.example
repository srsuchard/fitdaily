# ---------------------------------------------------------------------------
# FitDaily environment variables
# Copy this file to `.env` and fill in real values.
#
# Only EXPO_PUBLIC_* vars are exposed to the app bundle. NEVER put the OpenAI
# key or the Supabase service_role key here — those live ONLY in the Supabase
# Edge Function secrets (server side). See supabase/functions/generate-workout.
#
# With NO values set, the app still runs in "demo mode": local mock auth,
# mock workout generation, and a simulated premium toggle for previewing UI.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (RevenueCat → Project → API keys → "App-specific")
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Deployed Supabase Edge Function that calls the LLM and returns a workout.
# e.g. https://<project-ref>.functions.supabase.co/generate-workout
EXPO_PUBLIC_WORKOUT_FN_URL=
